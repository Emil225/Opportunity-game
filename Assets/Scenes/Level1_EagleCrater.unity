  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LevelManager
  queue: {fileID: 681137875}
  dialogue: {fileID: 61380029}
  objectiveText: {fileID: 1822482203}
  introSpeaker: Mission control
  introLines:
  - 25 January 2004. Opportunity has landed on Mars, inside a small crater on Meridiani Planum.
  - We call it Eagle crater. The rover is still sitting on its lander.
  - You are the rover driver. Queue up commands, press Send, and wait for the rover to carry them out.
  - See the pale rock in the crater wall? Drive closer, point the camera at it and take a photo.
  outroSpeaker: Mission control
  outroLines:
  - What a find. And this mission was only planned to last 90 Martian days.
  - Opportunity is just getting started.
  nextSceneName: Ending
