  m_Script: {fileID: 11500000, guid: 4d383e25b3a5d4243b3ba8cafb6e5839, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ScienceTarget
  targetName: Blueberries
  image: {fileID: 233323797533039979, guid: 039311df96e6dad4e815d786ed3b9898, type: 3}
  imageId: 
  credit: PLACEHOLDER, replace with the real NASA image
  caption: Small round grains in the rock of Eagle crater, nicknamed "blueberries".
  speakerName: Mission scientist
  dialogueLines:
  - Look at those little round grains in the rock! We call them blueberries.
  - They are made of a mineral called hematite.
  - On Earth, hematite like this usually forms in water.
  - So this rock is telling us that, long ago, there was water right here on Mars.
  aimPoint: {fileID: 1646401635}
