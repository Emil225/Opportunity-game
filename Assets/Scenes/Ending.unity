  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EndingScreen
  dialogue: {fileID: 812870836}
  credits: {fileID: 812870835}
  menu: {fileID: 1314360365}
  playAgainButton: {fileID: 568177331}
  creditsButton: {fileID: 528903345}
  speaker: Mission control
  lines:
  - Opportunity was built to work for 90 Martian days.
  - It kept going for almost 15 years, and drove more than 45 kilometres across Mars.
  - No vehicle had driven so far on another world. That record stood until October 2026.
  - In June 2018, a dust storm covered the whole planet and blocked the sunlight its solar panels needed.
  - Mission control last heard from Opportunity on 10 June 2018.
  - On 13 February 2019, NASA declared the end of the mission.
  - Opportunity is still there today, resting in Perseverance Valley.
  - Thank you, Opportunity.
  titleScene: StartScreen
